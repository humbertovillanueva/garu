{
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "garu-app.vercel.app"
        }
      ],
      "destination": "https://garuagents.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "garu-app.vercel.app"
        }
      ],
      "destination": "https://garuagents.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/demo.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=60"
        }
      ]
    }
  ]
}
