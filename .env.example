# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Only if Ollama runs somewhere other than this machine:
# OLLAMA_HOST=http://127.0.0.1:11434
# How your agents address you in chat (defaults to your login name)
GARU_USER=Humberto
# Where Tomay posts the morning brief (Slack or Discord incoming webhook URL)
BRIEF_WEBHOOK_URL=
# A push to your phone when an agent asks: an ntfy.sh topic URL (pick a long random name and subscribe
# to it in the ntfy app). The push names the agent, the tool and the reason, never the arguments.
# GARU_NOTIFY_URL=https://ntfy.sh/garu-your-random-topic
