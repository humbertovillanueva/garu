{
  "name": "@garu/app",
  "version": "0.1.0",
  "private": true,
  "description": "Garu for your phone — the control room as a native app, paired with the Garu running on your computer.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "sync": "npm run build:app -w @garu/ui && cap sync",
    "open": "cap open android",
    "open:ios": "cap open ios",
    "assets": "npx @capacitor/assets generate --android --ios --iconBackgroundColor '#0a0c0f' --iconBackgroundColorDark '#0a0c0f' --splashBackgroundColor '#f5f4f0' --splashBackgroundColorDark '#0a0c0f'"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/status-bar": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0"
  }
}
